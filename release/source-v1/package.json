    "react-dom": "19.2.8",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/node": "24.13.4",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.3",
    "playwright": "1.63.0",
    "prettier": "3.9.7",
    "typescript": "6.0.3",
    "vite": "7.3.6"
  }
