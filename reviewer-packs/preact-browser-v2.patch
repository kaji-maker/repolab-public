+		childVNode._index = matchingIndex;
+
+		oldVNode = null;
+		if (matchingIndex !== -1) {
+			oldVNode = oldChildren[matchingIndex];
+			remainingOldChildren--;
+			if (oldVNode) {
+				oldVNode._flags |= MATCHED;
+			}
+		}
